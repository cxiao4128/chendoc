NODE_ENV=test
HOST=127.0.0.1
PORT=8985
PUBLIC_SITE_URL=http://127.0.0.1:8985

DATABASE_PROVIDER=sqlite
DATABASE_URL=./.tmp/sqlite-test.sqlite
CHENDOC_ALLOW_SQLITE_RUNTIME=true

JWT_SECRET=e2e-jwt-secret-xxxxxxxxxxxxxxxxxx
JWT_EXPIRES_IN=2h
CONFIG_ENCRYPTION_KEY=e2e-config-secret-xxxxxxxxxxxxxxx
RSA_PRIVATE_KEY_ENCRYPTION_KEY=e2e-rsa-secret-xxxxxxxxxxxxxxxxxx
CHENDOC_DOCUMENT_ENCRYPTION_KEY=e2e-document-secret-xxxxxxxxxxxxx
CHENDOC_DOCUMENT_KEY_VERSION=v1

CHENDOC_FORCE_HTTPS=false
CHENDOC_TRUST_PROXY=127.0.0.1
CHENDOC_REQUIRE_UPLOAD_SCAN=false
CHENDOC_UPLOAD_SCAN_WEBHOOK=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=
R2_REGION=auto

MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=500
MAX_FILE_SIZE_MB=100

DEFAULT_ADMIN_USERNAME=e2eadmin
DEFAULT_ADMIN_PASSWORD=E2e!Password123
CHENDOC_ALLOW_WEAK_ADMIN_PASSWORD=false
