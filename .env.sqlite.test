NODE_ENV=production
HOST=0.0.0.0
PORT=8985
PUBLIC_SITE_URL=http://localhost:8985

# SQLite for testing
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./data/chendoc.sqlite

JWT_SECRET=test_secret_key_for_development_32_chars
JWT_EXPIRES_IN=2h

CONFIG_ENCRYPTION_KEY=test_encryption_key_32_bytes_please
RSA_PRIVATE_KEY_ENCRYPTION_KEY=test_encryption_key_32_bytes_please
CHENDOC_DOCUMENT_ENCRYPTION_KEY=test_encryption_key_32_bytes_please
CHENDOC_DOCUMENT_KEY_VERSION=v1

MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=500
MAX_FILE_SIZE_MB=100

DEFAULT_ADMIN_USERNAME=admin
CHENDOC_ALLOW_WEAK_ADMIN_PASSWORD=1
DEFAULT_ADMIN_PASSWORD=Test123456!

VITE_DISABLE_GATEWAY_PACKET=true
CHENDOC_ALLOW_SQLITE_RUNTIME=true