NODE_ENV=production
HOST=0.0.0.0
PORT=8985
PUBLIC_SITE_URL=https://docs.xchenai.top

# MySQL is the production runtime database.
DATABASE_PROVIDER=mysql
DATABASE_URL=mysql://user:password@127.0.0.1:3306/chendoc
MYSQL_CONNECTION_LIMIT=10
MYSQL_MAX_IDLE=5

# SQLite is kept only for historical migration/testing notes, not for runtime.
# DATABASE_PROVIDER=sqlite
# DATABASE_URL=file:./data/chendoc.sqlite

JWT_SECRET=please_change_this
JWT_EXPIRES_IN=2h
# IDLE_TIMEOUT_MS: 会话 idle 超时时间（毫秒），由 server/src/config/env-defaults.ts 生成
# 刷新页面时如果距离上次请求超过此时间，会话将失效
# IDLE_TIMEOUT_MS=14400000

CONFIG_ENCRYPTION_KEY=please_change_this_32_bytes_key

RSA_PRIVATE_KEY_ENCRYPTION_KEY=please_change_this_32_bytes_key

# AES-256-GCM key for document content at rest.
CHENDOC_DOCUMENT_ENCRYPTION_KEY=please_change_this_32_bytes_key
CHENDOC_DOCUMENT_KEY_VERSION=v1
# JSON object containing previous version keys during rotation, for example:
# CHENDOC_DOCUMENT_KEYRING={"v1":"old-secret-at-least-32-bytes"}
CHENDOC_DOCUMENT_KEYRING={}

# Reverse proxy must send X-Forwarded-Proto=https.
CHENDOC_FORCE_HTTPS=true
# Trust only a reverse proxy connected from the local machine.
CHENDOC_TRUST_PROXY=127.0.0.1,::1
# Comma-separated CSP connect-src hosts. Keep this to real R2/API hosts only.
CHENDOC_CSP_CONNECT_SRC=https://*.r2.cloudflarestorage.com

# Optional malware scanner. POST metadata; must return {"clean":true}.
CHENDOC_UPLOAD_SCAN_WEBHOOK=
CHENDOC_REQUIRE_UPLOAD_SCAN=true
CHENDOC_UPLOAD_ORPHAN_RETENTION_HOURS=1
CHENDOC_UPLOAD_DAILY_FILES=100
CHENDOC_UPLOAD_DAILY_MB=2048
CHENDOC_UPLOAD_STORED_MB=10240
CHENDOC_TRASH_RETENTION_DAYS=7
CHENDOC_BODY_LIMIT_MB=8

CHENDOC_LOG_RETENTION_DAYS=90
CHENDOC_FAILED_LOG_MAX_MB=20
CHENDOC_BACKUP_RETENTION_DAYS=30
CHENDOC_BACKUP_ENCRYPTION_KEY=please_change_this_32_bytes_key
CHENDOC_BACKUP_OFFSITE_DIR=
CHENDOC_BACKUP_VERIFY_DATABASE_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional object backup. Set to true and provide a different backup bucket if you want R2 object copies.
CHENDOC_REQUIRE_R2_BACKUP=false
R2_BACKUP_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=
R2_REGION=auto

MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=500
MAX_FILE_SIZE_MB=100

# Development only. Production keeps Gateway Packet Layer enabled by default.
# VITE_DISABLE_GATEWAY_PACKET=true

DEFAULT_ADMIN_USERNAME=xchen
# Optional legacy compatibility switch.
# Set to 1 only if you intentionally keep an old admin password such as 1314520x.
CHENDOC_ALLOW_WEAK_ADMIN_PASSWORD=0
# Required for production and for npm run admin:init.
# Use a unique 12+ character password; common leaked passwords are rejected.
DEFAULT_ADMIN_PASSWORD=

# deploy.sh reads this from the shell. First deployment:
# CHENDOC_INIT_ADMIN=1 bash ./deploy.sh
# To intentionally reset an existing admin password:
# CHENDOC_INIT_ADMIN=1 CHENDOC_RESET_ADMIN_PASSWORD=1 bash ./deploy.sh
