# ChenDoc 测试环境配置
# 用于 CI/CD 流水线、自动化测试、本地开发验证

NODE_ENV=test
HOST=127.0.0.1
PORT=8990

# 测试数据库使用 SQLite（内存模式或临时文件）
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./data/chendoc-test.sqlite
# 允许 SQLite 运行时（测试环境）
CHENDOC_ALLOW_SQLITE_RUNTIME=true

# JWT 测试密钥（固定值用于测试）
JWT_SECRET=test-jwt-secret-for-unit-tests-only
JWT_EXPIRES_IN=1h

# 加密密钥（测试用固定值）
CONFIG_ENCRYPTION_KEY=test-config-encryption-key-32b
RSA_PRIVATE_KEY_ENCRYPTION_KEY=test-rsa-key-encryption-32b
CHENDOC_DOCUMENT_ENCRYPTION_KEY=test-doc-encryption-key-32bytes!
CHENDOC_DOCUMENT_KEY_VERSION=v1
CHENDOC_DOCUMENT_KEYRING={}

# 测试环境禁用 HTTPS 强制
CHENDOC_FORCE_HTTPS=false
CHENDOC_TRUST_PROXY=127.0.0.1,::1
CHENDOC_CSP_CONNECT_SRC=http://localhost:*

# 测试上传配置
CHENDOC_UPLOAD_SCAN_WEBHOOK=
CHENDOC_REQUIRE_UPLOAD_SCAN=false
CHENDOC_UPLOAD_ORPHAN_RETENTION_HOURS=1
CHENDOC_UPLOAD_DAILY_FILES=1000
CHENDOC_UPLOAD_DAILY_MB=2048
CHENDOC_UPLOAD_STORED_MB=10240
CHENDOC_TRASH_RETENTION_DAYS=1
CHENDOC_BODY_LIMIT_MB=8

# 日志配置（测试环境减少日志量）
CHENDOC_LOG_RETENTION_DAYS=1
CHENDOC_FAILED_LOG_MAX_MB=1
CHENDOC_BACKUP_RETENTION_DAYS=1
CHENDOC_BACKUP_ENCRYPTION_KEY=test-backup-key-32-bytes!
CHENDOC_BACKUP_OFFSITE_DIR=
CHENDOC_BACKUP_VERIFY_DATABASE_URL=

# R2 配置（测试环境使用 mock）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=test-bucket
R2_PUBLIC_URL=http://localhost:9000
R2_ENDPOINT=http://localhost:9000
R2_REGION=auto

# 上传大小限制
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=50
MAX_FILE_SIZE_MB=20

# 管理员测试账号
DEFAULT_ADMIN_USERNAME=testadmin
DEFAULT_ADMIN_PASSWORD=test-password-123!
CHENDOC_ALLOW_WEAK_ADMIN_PASSWORD=1

# Playwright E2E 测试配置
PLAYWRIGHT_BROWSERS_PATH=./playwright-browsers
PLAYWRIGHT_REPORT_DIR=./playwright-report